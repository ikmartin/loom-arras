{
	"name": "arras",
	"description": "A static viewer for node-based text corpora published to the loom-arras interface.",
	"version": "0.1.0-alpha.0",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/ikmartin/arras.git"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node scripts/stage-fixture.mjs tests/fixture && vite dev",
		"build": "node scripts/stage-fixture.mjs --clean && vite build",
		"build:pip": "node scripts/copy-bundle.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"stage:fixture": "node scripts/stage-fixture.mjs tests/fixture",
		"build:prerender": "node scripts/build-prerender.mjs",
		"build:fixture": "node scripts/stage-fixture.mjs tests/fixture && vite build"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^22.20.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"elkjs": "^0.12.0",
		"mathjax": "^3.2.2",
		"ninja-keys": "^1.2.2"
	}
}
