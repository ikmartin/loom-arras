-    """Every master's number table and citation labels as one byte stream, serialised once per build rather than once per node."""
+    """Every master's number table and citation labels as one byte stream, serialised once per build rather than once per node.
+
+    Page numbers are left out: no fragment or preview loom renders prints one (a `\\pageref` is TeX's, keyed by `aux_digest`), and a page break that moves would otherwise re-render every block.
+    """
     parts: list[str] = []
     for m in sorted(numbers):
         for lab, num in sorted(numbers[m].items()):
-            parts.append(f"{m}|{lab}|{num.number}|{num.page}")
+            parts.append(f"{m}|{lab}|{num.number}")
     for m in sorted(cite_labels):
         for ck, lab in sorted(cite_labels[m].items()):
             parts.append(f"{m}|cite|{ck}|{lab}")
     return "".join(parts).encode()
+
+
+#: A command that prints a label's page, so a text using one is keyed on the aux's pages too.
+PAGEREF = re.compile(r"\\(?:[cvV]?pageref|[vV]ref|labelcpageref|cpagerefrange|pagerefrange)\b")
+#: The page group of a `\\newlabel{x}{{number}{page}...}` line.
+_NEWLABEL_PAGE = re.compile(r"^(\\newlabel\{[^\n]*?\}\{\{(?:[^{}\n]|\{[^{}\n]*\})*\})\{[^{}\n]*\}", re.M)
+#: Lines of an aux that record only where things fell on the page.
+_PAGE_ONLY = re.compile(r"^(?:\\@writefile|\\gdef\s*\\@abspage@last|\\abx@aux@page|\\zref@newlabel).*\n?", re.M)
+
+
+@cache
+def _aux_digests(path: str, mtime: int, size: int) -> tuple[str, str]:
+    raw = Path(path).read_bytes()
+    text = raw.decode("utf-8", errors="replace")
+    narrow = _NEWLABEL_PAGE.sub(r"\1{}", _PAGE_ONLY.sub("", text))
+    return hashlib.sha256(raw).hexdigest(), hashlib.sha256(narrow.encode()).hexdigest()
+
+
+def aux_digest(aux: Path | None, text: str) -> str:
+    """What a TeX-made text's cache key takes from its document's aux: the whole file's digest when `text` prints a page (`PAGEREF`), else the digest with page numbers and contents lines left out, so a moved page break remakes nothing; '' with no aux."""
+    if aux is None or not aux.is_file():
+        return ""
+    st = aux.stat()
+    whole, narrow = _aux_digests(str(aux), st.st_mtime_ns, st.st_size)
+    return whole if PAGEREF.search(text) else narrow
