+
+
+_GIT_NAMES: dict[tuple[Any, ...], str | None] = {}
+
+
+def _git_config_stamp(cwd: Path | None) -> tuple[Any, ...]:
+    """What `git config user.name` reads: the environment's overrides and each config file's mtime, the repository's found by walking up from `cwd`."""
+    home = Path.home()
+    xdg = os.environ.get("XDG_CONFIG_HOME") or str(home / ".config")
+    paths = [home / ".gitconfig", Path(xdg) / "git" / "config"]
+    here = (cwd or Path.cwd()).resolve()
+    for p in (here, *here.parents):
+        if (p / ".git").exists():
+            paths.append(p / ".git" / "config" if (p / ".git").is_dir() else p / ".git")
+            break
+    stamps = []
+    for p in paths:
+        try:
+            stamps.append(p.stat().st_mtime_ns)
+        except OSError:
+            stamps.append(None)
+    env = tuple(os.environ.get(k) for k in ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_NOSYSTEM", "HOME", "GIT_DIR"))
+    return (str(here), *stamps, *env)
+
