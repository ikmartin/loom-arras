+"""The one door (prototype): one-step undo of Keep, recovery of an interrupted act, two Keeps at once, and files that are not UTF-8."""
+
+from __future__ import annotations
+
+import json
+import threading
+from pathlib import Path
+
+from tests.unit.test_write_safety import call, q, suggest  # noqa: F401 -- the fixture
+
+NODE = "drafting/nodes/sy-000A.tex"
+
+
+def test_undo_of_a_keep_gives_back_the_bytes_and_the_edit_can_be_kept_again(q: Path) -> None:
+    node = q / NODE
+    node.write_bytes(node.read_bytes().replace(b"\n", b"\r\n"))
+    call(q, "change-keep", {"all": True})
+    before = node.read_bytes()
+    eid = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+    call(q, "change-keep", {"changes": [eid]})
+    assert node.read_bytes().count(b"Each swap fixes nothing.") == 1 and node.read_bytes().count(b"\r\n") == 3
+    assert call(q, "change-undo", {"changes": [eid]})["done"] == [eid]
+    assert node.read_bytes() == before
+    call(q, "change-keep", {"changes": [eid]})
+    assert node.read_bytes().count(b"Each swap fixes nothing.") == 1
+
+
+def test_undo_of_a_keep_survives_a_later_edit_elsewhere_and_refuses_one_inside(q: Path) -> None:
+    node = q / NODE
+    a = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+    b = suggest(q, "sy-000A", "A remark.", "--quote", "Gadgets exist:", "--before")
+    call(q, "change-keep", {"changes": [a]})
+    node.write_text(node.read_text() + "% my own line\n", encoding="utf-8")
+    call(q, "change-keep", {"changes": [b]})
+    assert call(q, "change-undo", {"changes": [a]})["done"] == [a]
+    text = node.read_text()
+    assert "Each swap fixes nothing." not in text and "A remark." in text and "% my own line" in text
+    call(q, "change-keep", {"changes": [a]})
+    node.write_text(node.read_text().replace("Each swap fixes nothing.", "Each swap fixes no point."), encoding="utf-8")
+    out = call(q, "change-undo", {"changes": [a]})
+    assert out["done"] == [] and "changed where it was written" in out["refused"][0]["why"]
+
+
+def test_a_kept_edit_is_not_reopened_with_its_words_left_in(q: Path) -> None:
+    eid = suggest(q, "sy-000A", "A gadget with three points has one fixed point.", "--quote", "\\end{remark}", "--after")
+    call(q, "change-keep", {"changes": [eid]})
+    out = call(q, "change-discard", {"changes": [eid], "undo": True})
+    assert out["done"] == [] and "change-undo" in out["refused"][0]["why"]
+
+
+def test_an_act_interrupted_after_its_write_is_finished_and_never_written_twice(q: Path, monkeypatch) -> None:
+    import loom.writes as writes
+
+    node = q / NODE
+    new = "A gadget with three points has one fixed point."
+    eid = suggest(q, "sy-000A", new, "--quote", "\\end{remark}", "--after")
+
+    class Crash(BaseException):
+        pass
+
+    real = writes.write_bytes
+
+    def write_then_die(path: Path, data: bytes) -> None:
+        real(path, data)
+        raise Crash
+
+    monkeypatch.setattr(writes, "write_bytes", write_then_die)
+    try:
+        call(q, "change-keep", {"changes": [eid]})
+    except Crash:
+        pass
+    monkeypatch.setattr(writes, "write_bytes", real)
+    assert node.read_text().count(new) == 1 and len(writes.unfinished(q)) == 1
+    out = call(q, "change-keep", {"changes": [eid]})  # recovery runs first, records it kept; this keep finds nothing to do
+    assert node.read_text().count(new) == 1 and not writes.unfinished(q)
+    assert "error" in out or out["done"] in ([], [eid])
+    from loom.records.edits import find
+
+    assert find(q, eid).status == "kept"  # type: ignore[union-attr]
+
+
+def test_an_act_interrupted_before_its_write_is_aborted(q: Path, monkeypatch) -> None:
+    import loom.writes as writes
+
+    node = q / NODE
+    old = node.read_bytes()
+    eid = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+
+    class Crash(BaseException):
+        pass
+
+    def die(path: Path, data: bytes) -> None:
+        raise Crash
+
+    monkeypatch.setattr(writes, "write_bytes", die)
+    try:
+        call(q, "change-keep", {"changes": [eid]})
+    except Crash:
+        pass
+    monkeypatch.undo()
+    assert node.read_bytes() == old and len(writes.unfinished(q)) == 1
+    out = call(q, "change-keep", {"changes": [eid]})
+    print("DEBUG", out, writes.entries(q))
+    assert node.read_text().count("Each swap fixes nothing.") == 1
+    assert any(e.get("event") == "aborted" for e in writes.entries(q))
+
+
+def test_two_keeps_at_once_lose_nothing(q: Path) -> None:
+    node = q / NODE
+    a = suggest(q, "sy-000A", "A gadget with three points has one fixed point.", "--quote", "\\end{remark}", "--after")
+    b = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+    outs: list[dict] = []
+    ts = [threading.Thread(target=lambda e=e: outs.append(call(q, "change-keep", {"changes": [e]}))) for e in (a, b)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    text = node.read_text()
+    from loom.records.edits import find
+
+    for e, words in ((a, "A gadget with three points"), (b, "Each swap fixes nothing.")):
+        status = find(q, e).status  # type: ignore[union-attr]
+        assert text.count(words) == (1 if status == "kept" else 0), (outs, status)
+    assert text.count("A gadget with three points") + text.count("Each swap fixes nothing.") >= 1
+
+
+def test_a_file_that_is_not_utf8_is_refused_whole(q: Path) -> None:
+    node = q / NODE
+    node.write_bytes(node.read_bytes().replace(b"Gadgets exist:", b"Gadgets (Schr\xf6der) exist:"))
+    old = node.read_bytes()
+    eid = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+    out = call(q, "change-keep", {"changes": [eid]})
+    assert node.read_bytes() == old
+    assert out["done"] == [] and "not UTF-8" in out["refused"][0]["why"]
+
+
+def test_every_write_is_journalled_with_its_bytes(q: Path) -> None:
+    from loom.writes import entries, fetch
+
+    eid = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+    before = (q / NODE).read_bytes()
+    call(q, "change-keep", {"changes": [eid]})
+    begin = [e for e in entries(q) if e.get("event") == "begin" and e.get("kind") == "keep"][-1]
+    b, a = begin["files"][NODE]
+    hist = q / ".loom/history"
+    assert fetch(hist, b) == before and fetch(hist, a) == (q / NODE).read_bytes()
+    assert json.dumps(begin)  # plain JSON
+
+
+def test_restoring_the_version_before_a_keep_opens_the_edit_again(q: Path) -> None:
+    from loom.history.acts import versions_of
+    from loom.history.ledger import load_history
+    from loom.records.edits import find
+    from loom.scan.quilt import load_quilt
+    from loom.scan.scan import scan
+
+    node = q / NODE
+    old = node.read_bytes()
+    eid = suggest(q, "sy-000A", "Each swap fixes nothing.", "--quote", "with the swap.", "--after")
+    call(q, "change-keep", {"changes": [eid]})
+    result = scan(load_quilt(q))
+    v = [e for e in versions_of(load_history(q / ".loom/history"), "drafting/main.tex", result.masters) if e.message == "Before keeping a suggested edit"][-1]
+    call(q, "history-restore", {"document": "drafting/main.tex", "version": v.name})
+    assert node.read_bytes() == old and find(q, eid).status == "open"  # type: ignore[union-attr]
+    call(q, "change-keep", {"changes": [eid]})
+    assert node.read_text().count("Each swap fixes nothing.") == 1
