@@ -0,0 +1,465 @@
+"""The one door (prototype): every write to a person's file goes through `act`.
+
+An act holds the history's `writes.lock` across processes, reads each file's bytes under it, checks them against what the caller planned from, keeps the before and after bytes exactly in the history's text store, writes a `begin` line to the journal before any file, writes each file atomically (unique temp, fsync, mode kept), runs the act's records, then writes `done`. An act id names the act, so a repeated act is a no-op returning its first answer. On every act the journal is read for a `begin` with no `done`: finished when every file holds its after bytes, marked aborted when every file holds its before bytes, else left and reported by `unfinished`.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import tempfile
+from collections.abc import Callable, Iterator
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from loom.locks import locked
+
+
+class WriteRefused(Exception):
+    """A write the door will not make, and why in the person's words; `code` is the write API's."""
+
+    def __init__(self, code: str, message: str, status: int = 409) -> None:
+        super().__init__(message)
+        self.code = code
+        self.message = message
+        self.status = status
+
+
+def digest(data: bytes | None) -> str | None:
+    return None if data is None else "sha256:" + hashlib.sha256(data).hexdigest()
+
+
+def store(history: Path, data: bytes) -> str:
+    """Keep `data` byte-exact in the history's text store, `<hex>.md` for UTF-8 and `<hex>.bin` otherwise; returns its digest.
+
+    Same name and hash as `snapshots.write_raw` for UTF-8 text, so a version, a look and the door share one store.
+    """
+    d = digest(data)
+    assert d is not None
+    try:
+        data.decode("utf-8")
+        suffix = ".md"
+    except UnicodeDecodeError:
+        suffix = ".bin"
+    p = history / "texts" / f"{d.split(':', 1)[1]}{suffix}"
+    if not p.is_file():
+        p.parent.mkdir(parents=True, exist_ok=True)
+        fd, tmp = tempfile.mkstemp(dir=p.parent, prefix=".store.")
+        with os.fdopen(fd, "wb") as fh:
+            fh.write(data)
+        os.replace(tmp, p)
+    return d
+
+
+def fetch(history: Path, d: str) -> bytes | None:
+    hexd = d.split(":", 1)[-1]
+    for suffix in (".md", ".bin"):
+        p = history / "texts" / f"{hexd}{suffix}"
+        if p.is_file():
+            return p.read_bytes()
+    return None
+
+
+def fresh_id(prefix: str) -> str:
+    """A unique act id, for an act whose repeat a record already refuses (the change is no longer pending) or whose effect is a state, so repeating it changes nothing: deriving such an id from content alone would name a later act like an earlier one when a state recurs."""
+    import uuid
+
+    return f"{prefix}#{uuid.uuid4().hex[:12]}"
+
+
+def _target(path: Path) -> Path:
+    """The file a write lands in: a symlink's target, so the link stays a link."""
+    return Path(os.path.realpath(path)) if path.is_symlink() else path
+
+
+def write_bytes(path: Path, data: bytes) -> None:
+    """Write `data` to `path` whole or not at all: a unique temp beside it, fsync, the file's mode kept, `os.replace`."""
+    path = _target(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        mode: int | None = path.stat().st_mode & 0o7777
+    except FileNotFoundError:
+        mode = None
+    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".loom-tmp")
+    try:
+        with os.fdopen(fd, "wb") as fh:
+            fh.write(data)
+            fh.flush()
+            os.fsync(fh.fileno())
+        if mode is None:
+            umask = os.umask(0)
+            os.umask(umask)
+            mode = 0o666 & ~umask
+        os.chmod(tmp, mode)
+        os.replace(tmp, path)
+    finally:
+        Path(tmp).unlink(missing_ok=True)
+
+
+def _remove(path: Path) -> None:
+    path.unlink(missing_ok=True)
+
+
+# ---- the journal ----------------------------------------------------------------------------------------------------
+
+
+_HISTORY: dict[Path, Path] = {}
+
+
+def _history_of(root: Path) -> Path:
+    """The quilt's history directory (`[quilt] history`), where the journal and its lock live: protected from agents already, beside the text store that holds every before and after."""
+    held = _HISTORY.get(root)
+    if held is None:
+        from loom.scan.quilt import load_quilt
+
+        held = _HISTORY[root] = load_quilt(root).history_dir
+    return held
+
+
+def _journal(root: Path) -> Path:
+    return _history_of(root) / "writes.jsonl"
+
+
+def entries(root: Path) -> list[dict[str, Any]]:
+    p = _journal(root)
+    if not p.is_file():
+        return []
+    out = []
+    for line in p.read_text(encoding="utf-8").splitlines():
+        try:
+            out.append(json.loads(line))
+        except json.JSONDecodeError:
+            continue
+    return out
+
+
+def _append(root: Path, entry: dict[str, Any]) -> None:
+    p = _journal(root)
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with p.open("a", encoding="utf-8") as fh:
+        fh.write(json.dumps(entry, ensure_ascii=False, sort_keys=True) + "\n")
+        fh.flush()
+        os.fsync(fh.fileno())
+
+
+def _settled(root: Path) -> tuple[dict[str, dict[str, Any]], dict[str, dict[str, Any]], set[str]]:
+    """Each act's `begin` and `done` by id, and the ids aborted."""
+    begun: dict[str, dict[str, Any]] = {}
+    done: dict[str, dict[str, Any]] = {}
+    aborted: set[str] = set()
+    for e in entries(root):
+        if e.get("event") == "begin":
+            begun[e["act"]] = e
+            aborted.discard(e["act"])
+        elif e.get("event") == "done":
+            done[e["act"]] = e
+        elif e.get("event") == "aborted":
+            aborted.add(e["act"])
+    return begun, done, aborted
+
+
+def written_edits(root: Path) -> set[str]:
+    """Every `<edit id>:<generation>` a keep act wrote (begun and not aborted): what loom wrote, by record."""
+    begun, done, aborted = _settled(root)
+    out: set[str] = set()
+    for a, e in begun.items():
+        if a in aborted or not e.get("edits"):
+            continue
+        # an act a crash left unfinished wrote its edits only if its files hold what it wrote, as recovery will find
+        if a in done or all(_holds(root, rel, ab[1]) for rel, ab in e.get("files", {}).items()):
+            out.update(e["edits"])
+    return out
+
+
+def last_act(root: Path, edit_gen: str) -> dict[str, Any] | None:
+    """The finished keep act that wrote `edit_gen`, for its undo."""
+    begun, done, aborted = _settled(root)
+    found = [e for a, e in begun.items() if a in done and a not in aborted and edit_gen in e.get("edits", [])]
+    return found[-1] if found else None
+
+
+def unfinished(root: Path) -> list[dict[str, Any]]:
+    """Acts begun and neither done nor aborted: what a crash left that recovery could not settle."""
+    begun, done, aborted = _settled(root)
+    return [e for a, e in begun.items() if a not in done and a not in aborted]
+
+
+def _holds(root: Path, rel: str, want: str | None) -> bool:
+    p = root / rel
+    if want is None:
+        return not p.exists()
+    try:
+        return digest(p.read_bytes()) == want
+    except OSError:
+        return False
+
+
+def recover(root: Path) -> list[str]:
+    """Settle each act a crash left begun: finish it (its record lines, then `done`) when every file holds its after bytes, abort it when every file holds its before bytes; leave the rest. Temp files the act left are removed. Returns what was done, in words."""
+    said = []
+    for e in unfinished(root):
+        files: dict[str, list[str | None]] = e.get("files", {})
+        for rel in files:
+            t = _target(root / rel)
+            for tmp in t.parent.glob(f".{t.name}.*.loom-tmp"):
+                tmp.unlink(missing_ok=True)
+        if all(_holds(root, rel, ab[1]) for rel, ab in files.items()):
+            for rec in e.get("records", []):
+                p = root / rec["log"]
+                p.parent.mkdir(parents=True, exist_ok=True)
+                with locked(p), p.open("a", encoding="utf-8") as fh:
+                    fh.write(json.dumps(rec["line"], ensure_ascii=False, sort_keys=True) + "\n")
+            _append(root, {"event": "done", "act": e["act"], "answer": e.get("answer"), "recovered": True})
+            said.append(f"finished {e['act']}")
+        elif all(_holds(root, rel, ab[0]) for rel, ab in files.items()):
+            _append(root, {"event": "aborted", "act": e["act"]})
+            said.append(f"aborted {e['act']}")
+    return said
+
+
+# ---- an act ---------------------------------------------------------------------------------------------------------
+
+
+@dataclass
+class Act:
+    """One act through the door, staged until the block ends."""
+
+    root: Path
+    history: Path
+    kind: str
+    id: str
+    actor: str | None
+    previous: dict[str, Any] | None = None  # the earlier answer, when this act is done already
+    before: dict[str, bytes | None] = field(default_factory=dict)
+    after: dict[str, bytes | None] = field(default_factory=dict)
+    splices: dict[str, list[dict[str, Any]]] = field(default_factory=dict)
+    edits: list[str] = field(default_factory=list)
+    records: list[dict[str, Any]] = field(default_factory=list)
+    follow: list[Callable[[], None]] = field(default_factory=list)
+    answer: Any = None
+    extra: dict[str, Any] = field(default_factory=dict)
+
+    def read(self, rel: str) -> bytes | None:
+        """The file's bytes now, under the lock; the first read is what the act replaces."""
+        p = _target(self.root / rel)
+        data = p.read_bytes() if p.is_file() else None
+        self.before.setdefault(rel, data)
+        return data
+
+    def text(self, rel: str) -> str | None:
+        """The file as UTF-8 text with its own line endings, or WriteRefused for a file that is not UTF-8."""
+        data = self.read(rel)
+        if data is None:
+            return None
+        try:
+            return data.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise WriteRefused(
+                "not-utf8", f"{rel} is not UTF-8 text, so loom does not write into it; save it as UTF-8 first"
+            ) from exc
+
+    def expect(self, rel: str, planned: str | None, *, newlines: bool = False) -> None:
+        """Refuse unless the file still reads as `planned`, the text the caller planned from (`newlines`: compared with CRLF and CR read as LF, as the scan reads)."""
+        now = self.text(rel)
+        if newlines and now is not None:
+            now = now.replace("\r\n", "\n").replace("\r", "\n")
+        if now != planned:
+            raise WriteRefused("changed", f"{rel} changed since loom read it; nothing was written, look at it again")
+
+    def replace(self, rel: str, data: bytes | None, splices: list[dict[str, Any]] | None = None) -> None:
+        """Stage `data` as the file's new bytes (None removes it); `splices` say what replaced what, for an undo."""
+        if rel not in self.before:
+            self.read(rel)
+        self.after[rel] = data
+        if splices:
+            self.splices.setdefault(rel, []).extend(splices)
+
+    def log(self, log: str, line: dict[str, Any]) -> None:
+        """A record line the act appends to `log` (quilt-relative) after its files; recovery appends it too."""
+        self.records.append({"log": log, "line": line})
+
+    def then(self, fn: Callable[[], None]) -> None:
+        """A step after the files and before `done` (rescans, looks, carries): not replayed by recovery."""
+        self.follow.append(fn)
+
+    def _append_records(self) -> None:
+        for rec in self.records:
+            p = self.root / rec["log"]
+            p.parent.mkdir(parents=True, exist_ok=True)
+            with locked(p), p.open("a", encoding="utf-8") as fh:
+                fh.write(json.dumps(rec["line"], ensure_ascii=False, sort_keys=True) + "\n")
+
+    def _commit(self) -> None:
+        changed = {rel: self.after[rel] for rel in self.after if self.after[rel] != self.before.get(rel)}
+        if not changed:
+            # nothing written: no journal, so the same act asked again is free to write; its records still stand
+            self._append_records()
+            for fn in self.follow:
+                fn()
+            return
+        files = {}
+        for rel, data in changed.items():
+            b = self.before.get(rel)
+            files[rel] = [store(self.history, b) if b is not None else None, store(self.history, data) if data is not None else None]
+        _append(
+            self.root,
+            {
+                "event": "begin",
+                "act": self.id,
+                "kind": self.kind,
+                "actor": self.actor,
+                "files": files,
+                "splices": {rel: s for rel, s in self.splices.items() if rel in changed},
+                "edits": self.edits,
+                "records": self.records,
+                "answer": self.answer,
+                **self.extra,
+            },
+        )
+        for rel, data in changed.items():
+            if data is None:
+                _remove(self.root / rel)
+            else:
+                write_bytes(self.root / rel, data)
+        self._append_records()
+        for fn in self.follow:
+            fn()
+        _append(self.root, {"event": "done", "act": self.id, "answer": self.answer})
+
+
+@contextmanager
+def act(root: Path, history: Path, kind: str, act_id: str, actor: str | None = None) -> Iterator[Act]:
+    """Hold the door for one act; the act is written when the block ends without an exception.
+
+    Parameters
+    ----------
+    root : Path
+        The quilt.
+    history : Path
+        The quilt's history directory, whose `texts/` store keeps every before and after.
+    kind : str
+        What the act is: keep, discard, put-back, restore, tick, settings, undo.
+    act_id : str
+        Names the act; an act whose `done` is in the journal is not done again (`Act.previous` holds its answer).
+    actor : str, optional
+        Who.
+
+    Yields
+    ------
+    Act
+    """
+    _HISTORY.setdefault(root, history)
+    with locked(history / "writes.lock"):
+        recover(root)
+        _begun, done, _aborted = _settled(root)
+        a = Act(root, history, kind, act_id, actor)
+        if act_id in done:
+            a.previous = {"answer": done[act_id].get("answer")}
+            yield a
+            return
+        yield a
+        a._commit()
+
+
+# ---- bytes from a scan's text ---------------------------------------------------------------------------------------
+
+
+def newline_of(text: str) -> str:
+    """The file's line ending: CRLF when most of its lines end so, else LF."""
+    crlf = text.count("\r\n")
+    return "\r\n" if crlf and crlf >= text.count("\n") - crlf else "\n"
+
+
+def raw_offsets(raw: str) -> list[int]:
+    """For each offset of `raw` read as the scan reads it (CRLF and CR as LF), the offset in `raw`; one more for the end."""
+    out = []
+    i = 0
+    while i < len(raw):
+        out.append(i)
+        i += 2 if raw[i] == "\r" and raw[i + 1 : i + 2] == "\n" else 1
+    out.append(len(raw))
+    return out
+
+
+def splice(raw: str, spans: list[tuple[int, int, str]]) -> tuple[str, list[dict[str, Any]]]:
+    """Put each `(a, b, text)` (offsets in the scan's reading of `raw`) into `raw`, every other byte kept, `text` in the file's own line endings; returns the new text and the splices made (raw offsets in the new text, old and new words)."""
+    pos = raw_offsets(raw)
+    nl = newline_of(raw)
+    out = raw
+    made = []
+    for a, b, text in sorted(spans, reverse=True):
+        ra, rb = pos[a], pos[b]
+        new = text.replace("\n", nl) if nl != "\n" else text
+        made.append({"old": out[ra:rb], "new": new, "at": ra})
+        out = out[:ra] + new + out[rb:]
+    # offsets in the new text, in order
+    made.reverse()
+    shift = 0
+    for m in made:
+        m["at"] += shift
+        shift += len(m["new"]) - len(m["old"])
+    return out, made
+
+
+def undo(
+    root: Path,
+    history: Path,
+    act_entry: dict[str, Any],
+    act_id: str,
+    actor: str | None,
+    *,
+    only: str | None = None,
+    records: list[tuple[str, dict[str, Any]]] | None = None,
+    look: str | None = None,
+) -> list[str]:
+    """Write back what the act `act_entry` replaced, as a new act named `act_id`: the whole file when it still holds the act's after bytes and the act wrote no other edit there, else each splice (of `only`, an edit's `<id>:<generation>`) whose new words stand exactly once; WriteRefused when neither. `records` are appended with it; `look` is a reviewer whose look holding the act's after text follows the file back. Returns the paths written."""
+    paths: list[str] = []
+    with act(root, history, "undo", act_id, actor) as w:
+        if w.previous is not None:
+            return list(act_entry.get("files", {}))
+        for rel, (before, after) in act_entry.get("files", {}).items():
+            splices = [s for s in act_entry.get("splices", {}).get(rel, []) if only is None or s.get("edit") == only]
+            if only is not None and not splices:
+                continue
+            others = [s for s in act_entry.get("splices", {}).get(rel, []) if s not in splices]
+            now = w.read(rel)
+            if digest(now) == after and not others:
+                w.replace(rel, fetch(history, before) if before else None)
+            else:
+                text = w.text(rel) or ""
+                for s in reversed(splices):
+                    if s["new"] and text.count(s["new"]) == 1:
+                        i = text.index(s["new"])
+                        text = text[:i] + s["old"] + text[i + len(s["new"]) :]
+                    else:
+                        raise WriteRefused(
+                            "changed-since",
+                            f"{rel} changed where it was written since; restore a version from The Record instead",
+                        )
+                w.replace(rel, text.encode("utf-8"))
+            paths.append(rel)
+        for log, line in records or []:
+            w.log(log, line)
+        if look:
+            w.then(lambda: _look_follows(root, history, look, w))
+    return paths
+
+
+def _look_follows(root: Path, history: Path, who: str, w: Act) -> None:
+    """Where `who`'s look held a file exactly as the act found it, it holds the file as the act left it: loom's write is no change of the person's."""
+    from loom.looks import _write, read_look
+
+    look = read_look(root, who)
+    if look is None:
+        return
+    moved = False
+    for rel, data in w.after.items():
+        b = w.before.get(rel)
+        if b is not None and look.files.get(rel) == digest(b) and data is not None:
+            look.files[rel] = store(history, data)
+            moved = True
+    if moved:
+        _write(root, look)
