#!/usr/bin/env python3
"""Time the operations plan 0.18.2 sets targets for, on a copy of a quilt: one table, each row against its target.

Usage:
    scripts/bench                 the demo quilt, made fresh by `loom init --demo`
    scripts/bench PATH            a copy of the quilt at PATH; the original is never written
    scripts/bench PATH --skip cold   leave out rows by name (cold, cached, edit, commands, serve)
    scripts/bench PATH --loom EXE    time another build of loom, e.g. a frozen copy of the last commit's, for a baseline

Every command runs as the author would run it, in a shell with the agent markers removed, through the `loom` on PATH. The copy lives in a temporary directory removed at the end unless `--keep` is given. `serve` rows are measured over HTTP against `loom serve --no-compile` on a free port: a write is timed until it answers, an edit until the published manifest changes.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

AGENT_MARKERS = ("AI_AGENT", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT")
ENV = {k: v for k, v in os.environ.items() if k not in AGENT_MARKERS}
LOOM = ["loom"]

TARGETS = {
    "cold build": 180.0,
    "cached build": 5.0,
    "edit one result, republished": 3.0,
    "status": 3.0,
    "lint": 3.0,
    "deps KEY": 3.0,
    "ai orient": 3.0,
    "accept KEY": 3.0,
    "serve: first build, already built": 10.0,
    "serve: session-new": 1.0,
    "serve: annotate": 1.0,
    "serve: message": 1.0,
}


def loom(q: Path, *args: str) -> float:
    """Run `loom ARGS` in the quilt and return its wall time; a failure stops the bench with its output."""
    started = time.perf_counter()
    run = subprocess.run([*LOOM, *args], cwd=q, env=ENV, capture_output=True, text=True)
    took = time.perf_counter() - started
    if run.returncode not in (0, 1):
        sys.exit(f"loom {' '.join(args)} exited {run.returncode}:\n{run.stdout}\n{run.stderr}")
    return took


def copy_of(source: Path | None, home: Path) -> Path:
    q = home / "q"
    if source is None:
        subprocess.run([*LOOM, "init", str(q), "--demo", "--ai", "none"], env=ENV, check=True, capture_output=True)
    else:
        shutil.copytree(source, q, ignore=shutil.ignore_patterns(".git"), symlinks=True)
    return q


def a_result(q: Path) -> tuple[str, str]:
    """An environment of the quilt's own, and the file that defines it, from the published manifest."""
    m = json.loads((q / "build" / "manifest.json").read_text())
    for node in m["nodes"].values():
        key, file = node.get("id"), node.get("file")
        if node.get("kind") != "environment" or node.get("external") or node.get("digest") or not key or not file:
            continue
        if f"\\label{{{key}}}" in (q / file).read_text(encoding="utf-8"):
            return key, file
    sys.exit("the quilt has no labelled environment of its own to edit")


def edit(q: Path, key: str, file: str, n: int) -> None:
    """Add a word to the statement labelled `key`, so its text, and the published manifest, change."""
    p = q / file
    text = p.read_text(encoding="utf-8")
    label = f"\\label{{{key}}}"
    if label not in text:
        sys.exit(f"{file} has no {label}")
    p.write_text(text.replace(label, f"{label} Bench{n}.", 1), encoding="utf-8")


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


class Serve:
    """`loom serve` on the copy, its output read line by line with the time each arrived."""

    def __init__(self, q: Path) -> None:
        self.port = free_port()
        self.base = f"http://127.0.0.1:{self.port}"
        self.lines: list[tuple[float, str]] = []
        self.started = time.perf_counter()
        self.proc = subprocess.Popen(
            [*LOOM, "serve", "--port", str(self.port), "--no-compile"],
            cwd=q,
            env=ENV,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self) -> None:
        assert self.proc.stdout is not None
        for line in self.proc.stdout:
            self.lines.append((time.perf_counter(), line.rstrip()))

    def wait_for(self, pattern: str, timeout: float = 1800) -> float:
        """Seconds from start until a line matching `pattern` was printed."""
        end = time.perf_counter() + timeout
        while time.perf_counter() < end:
            for at, line in self.lines:
                if re.search(pattern, line):
                    return at - self.started
            if self.proc.poll() is not None:
                sys.exit("loom serve exited:\n" + "\n".join(line for _, line in self.lines))
            time.sleep(0.05)
        sys.exit(f"loom serve never printed {pattern!r}")

    def key_hash(self, key: str) -> str:
        """The published hash of `key`'s text: what an edit to it changes, and nothing else does."""
        with urllib.request.urlopen(self.base + "/build/manifest.json") as r:
            return str(json.loads(r.read())["keys"].get(key, {}).get("hash"))

    def post(self, endpoint: str, body: dict[str, object]) -> tuple[float, dict]:
        with urllib.request.urlopen(self.base + "/_api") as r:
            token = json.loads(r.read())["token"]
        request = urllib.request.Request(
            f"{self.base}/_api/{endpoint}",
            data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json", "X-Loom-Token": token},
            method="POST",
        )
        started = time.perf_counter()
        try:
            with urllib.request.urlopen(request) as r:
                answer = json.loads(r.read())
        except urllib.error.HTTPError as exc:
            sys.exit(f"{endpoint} {json.dumps(body)} was refused: {exc.read().decode()}")
        return time.perf_counter() - started, answer

    def stop(self) -> None:
        self.proc.terminate()
        try:
            self.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.proc.kill()


class Rows(dict):  # type: ignore[type-arg]
    """The table, each row printed as it is measured, so a run stopped part way still says what it found."""

    WIDTH = max(len(name) for name in TARGETS)

    def __init__(self) -> None:
        super().__init__()
        print(f"{'operation'.ljust(self.WIDTH)}  {'seconds':>8}  {'target':>7}", flush=True)

    def __setitem__(self, name: str, took: float) -> None:
        super().__setitem__(name, took)
        target = TARGETS[name]
        print(f"{name.ljust(self.WIDTH)}  {took:8.2f}  {target:7.1f}  {'ok' if took <= target else 'OVER'}", flush=True)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("quilt", nargs="?", type=Path, help="the quilt to copy; default a fresh demo")
    parser.add_argument("--skip", action="append", default=[], choices=["cold", "cached", "edit", "commands", "serve"])
    parser.add_argument("--keep", action="store_true", help="keep the copy and print where it is")
    parser.add_argument("--loom", default="loom", help="the loom executable to time; default the one on PATH")
    args = parser.parse_args()
    LOOM[:] = [args.loom]
    home = Path(tempfile.mkdtemp(prefix="loom-bench-"))
    rows = Rows()
    try:
        q = copy_of(args.quilt.resolve() if args.quilt else None, home)
        if "cold" not in args.skip:
            shutil.rmtree(q / "build", ignore_errors=True)
            rows["cold build"] = loom(q, "build")
        elif not (q / "build" / "manifest.json").is_file():
            loom(q, "build")
        if "cached" not in args.skip:
            rows["cached build"] = loom(q, "build")
        key, file = a_result(q)
        if "commands" not in args.skip:
            rows["status"] = loom(q, "status")
            rows["lint"] = loom(q, "lint")
            rows["deps KEY"] = loom(q, "deps", key)
            rows["ai orient"] = loom(q, "ai", "orient")
            rows["accept KEY"] = loom(q, "accept", key, "--as", "Bench", "--force", "--yes")
        if "serve" not in args.skip or "edit" not in args.skip:
            s = Serve(q)
            try:
                rows["serve: first build, already built"] = s.wait_for(r"loom serve: built ")
                if "serve" not in args.skip:
                    took, answer = s.post("session-new", {"title": "bench", "author": "Bench"})
                    rows["serve: session-new"] = took
                    session = str(answer["result"]).split()[0]  # "s-…  title  (active)"
                    rows["serve: annotate"], _ = s.post(
                        "annotate", {"target": key, "message": "A bench note.", "session": session, "author": "Bench"}
                    )
                    rows["serve: message"], _ = s.post("message", {"text": "A bench message.", "session": session, "author": "Bench"})
                if "edit" not in args.skip:
                    time.sleep(3)  # let the watcher settle after the writes above
                    before = s.key_hash(key)
                    seen = len(s.lines)
                    edit(q, key, file, 1)
                    started = time.perf_counter()
                    # the publication's own log line, so the bench's polling does not compete with the build it times
                    while not any(f"rebuilt after change to {file}" in line for _, line in s.lines[seen:]):
                        if time.perf_counter() - started > 600:
                            sys.exit("the edit was never republished")
                        time.sleep(0.02)
                    at = next(t for t, line in s.lines[seen:] if f"rebuilt after change to {file}" in line)
                    if s.key_hash(key) == before:
                        sys.exit("the edit was published without the edited text")
                    rows["edit one result, republished"] = at - started
            finally:
                s.stop()
    finally:
        if args.keep:
            print(f"copy kept at {home / 'q'}")
        else:
            shutil.rmtree(home, ignore_errors=True)


if __name__ == "__main__":
    main()
